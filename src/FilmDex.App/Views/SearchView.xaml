<UserControl x:Class="FilmDex.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:FilmDex.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:SearchViewModel}">

    <Grid Margin="30,26,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="جستجو" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Muted}" MaxWidth="700" HorizontalAlignment="Right"
                       Text="اسم فیلمی که می‌خواهی دانلود کنی را بزن. لازم نیست دقیق باشد — هر چه شبیه باشد با درصد شباهت می‌آید." />
        </StackPanel>

        <!-- Search bar -->
        <Border Grid.Row="1" CornerRadius="16" Padding="6" Margin="0,0,0,14"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="Magnify" Width="26" Height="26"
                                         Margin="14,0,6,0" VerticalAlignment="Center" Opacity="0.6" />

                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SearchBox"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=0}"
                         materialDesign:HintAssist.Hint="مثلاً: the matrix ۱۹۹۹ یا ماتریکس"
                         BorderThickness="0" Background="Transparent"
                         FontSize="19" Padding="6,12" VerticalContentAlignment="Center" />

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0,10,0">
                    <TextBlock Text="آستانه" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,10,0" />
                    <Slider Value="{Binding MinPercent}" Minimum="30" Maximum="100"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            Width="190" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="46" FontWeight="SemiBold">
                        <Run Text="{Binding MinPercent, Mode=OneWay}" /><Run Text="٪" />
                    </TextBlock>
                </StackPanel>

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" IsIndeterminate="True" Height="3"
                             Margin="10,6,10,2"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- What the query became, and how many names were looked at -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,0,4,14">
            <Border CornerRadius="9" Padding="12,4"
                    Background="{DynamicResource MaterialDesignDivider}"
                    Visibility="{Binding ParsedSummary, Converter={StaticResource TextToVisibility}}">
                <TextBlock Text="{Binding ParsedSummary}" FontSize="12" />
            </Border>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <!-- Results -->
        <Border Grid.Row="3" CornerRadius="16" ClipToBounds="True"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="46"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="نام موجود در آرشیو" Width="2.4*"
                                            SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="viewModels:SearchResultRow">
                                <!-- Left to right, so a long release name loses its tail, never its title. -->
                                <DockPanel FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="10,0">
                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="{Binding Icon}"
                                                             Width="19" Height="19"
                                                             VerticalAlignment="Center" Opacity="0.7" />
                                    <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="٪ عنوان" Width="Auto" SortMemberPath="TitlePercent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="viewModels:SearchResultRow">
                                <Border CornerRadius="9" Padding="11,3" Margin="10,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{Binding TitlePercent, Converter={StaticResource PercentToBrush}}">
                                    <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="12">
                                        <Run Text="{Binding TitlePercent, Mode=OneWay}" /><Run Text="٪" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="٪ نام خام" Width="Auto" SortMemberPath="RawPercent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="viewModels:SearchResultRow">
                                <Border CornerRadius="9" Padding="11,3" Margin="10,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{Binding RawPercent, Converter={StaticResource PercentToBrush}}">
                                    <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="12">
                                        <Run Text="{Binding RawPercent, Mode=OneWay}" /><Run Text="٪" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="سال" Width="Auto" SortMemberPath="YearText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="viewModels:SearchResultRow">
                                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding YearText}" VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="15" Height="15"
                                                             Margin="5,0,0,0" VerticalAlignment="Center"
                                                             Foreground="#E0A030"
                                                             ToolTip="{Binding YearTooltip}"
                                                             Visibility="{Binding YearMismatch,
                                                                 Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="کتابخانه" Binding="{Binding LibraryLabel}" Width="Auto" />

                    <DataGridTextColumn Header="حجم" Binding="{Binding SizeText}" Width="Auto" />

                    <DataGridTemplateColumn Header="مسیر" Width="2*" SortMemberPath="FullPath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="viewModels:SearchResultRow">
                                <TextBlock Text="{Binding FullPath}" Margin="10,0" VerticalAlignment="Center"
                                           Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}" FlowDirection="LeftToRight" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="viewModels:SearchResultRow">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="6" MinWidth="0" ToolTip="کپی مسیر"
                                            Command="{Binding DataContext.CopyPathCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="17" Height="17" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="6" MinWidth="0" Margin="2,0,0,0" ToolTip="باز کردن پوشه"
                                            Command="{Binding DataContext.OpenFolderCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="17" Height="17" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Nothing found -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasResults, Converter={StaticResource NotToVisibility}}"
                    IsHitTestVisible="False">
            <materialDesign:PackIcon Kind="MagnifyScan" Width="52" Height="52"
                                     HorizontalAlignment="Center" Opacity="0.35" />
            <TextBlock Text="{Binding Status}" Margin="0,14,0,0" HorizontalAlignment="Center"
                       Opacity="0.7" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
