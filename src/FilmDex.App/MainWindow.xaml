<Window x:Class="FilmDex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:FilmDex.App.Views"
        mc:Ignorable="d"
        Title="FilmDex — آرشیو نام فیلم‌ها"
        Height="800" Width="1240" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma"
        FontSize="14"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}">
            <DockPanel Margin="14,18">

                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,26">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12"
                                Background="{DynamicResource PrimaryHueMidBrush}">
                            <materialDesign:PackIcon Kind="Movie" Width="24" Height="24"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FilmDex" FontSize="19" FontWeight="Bold" FlowDirection="LeftToRight"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="نام‌ها را یک‌بار می‌خواند" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,20,8,0">
                    <Separator Opacity="0.25" Margin="0,0,0,10" />
                    <TextBlock Text="پوشه‌ها را می‌توانی روی همین پنجره بکشی و رها کنی."
                               Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>

                <ListBox SelectedIndex="{Binding Section, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" Focusable="False">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderMultiple" Width="21" Height="21"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="کتابخانه‌ها" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="21" Height="21"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="جستجو" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <views:LibrariesView DataContext="{Binding Libraries}"
                                 Visibility="{Binding DataContext.Section,
                                     RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource SectionToVisibility},
                                     ConverterParameter=0}" />

            <views:SearchView DataContext="{Binding Search}"
                              Visibility="{Binding DataContext.Section,
                                  RelativeSource={RelativeSource AncestorType=Window},
                                  Converter={StaticResource SectionToVisibility},
                                  ConverterParameter=1}" />
        </Grid>
    </Grid>
</Window>
